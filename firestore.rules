rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
        && request.auth.uid == "PASTE_ADMIN_UID_HERE";
    }

    match /stories/{storyId} {
      // Everyone can read published stories. Only the admin can write.
      allow read: if resource.data.published == true || isAdmin();
      allow create: if isAdmin()
        && request.resource.data.published == true
        && request.resource.data.title is string
        && request.resource.data.writer is string
        && request.resource.data.type is string
        && request.resource.data.content is string;
      allow update, delete: if isAdmin();
    }

    // No public writes to other collections by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}